# --- Database (required) ---
# MongoDB Atlas connection string. Free M0 cluster works:
# https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=disease-data

# --- Maps (required for the map + geocoding) ---
# Mapbox access token: https://console.mapbox.com/account/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ...
# Optional separate server-side token for geocoding; falls back to the public one.
# MAPBOX_TOKEN=pk.eyJ...

# --- AI analysis (required for the pipeline) ---
# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...
# Optional model override (default: gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-3.7-flash

# --- Pipeline (required in production) ---
# Shared secret protecting /api/cron/*. Vercel Cron sends it automatically as
# "Authorization: Bearer <CRON_SECRET>" once set in the Vercel project env.
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# --- Pipeline tuning (optional) ---
# PIPELINE_MAX_DEPTH=2            # link-follow depth from the source URL
# PIPELINE_MAX_PAGES=200          # max pages crawled per source per cycle
# PIPELINE_TIME_BUDGET_MS=240000  # soft per-invocation budget (< maxDuration)
